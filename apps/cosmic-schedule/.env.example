# Optional self-hosted sync. Do not set this for a purely local/static edition.
VITE_SYNC_ENDPOINT=/api/state

# Required for npm start. Choose credentials for your own household instance.
PLANNER_USERNAME=
PLANNER_PASSWORD=

# Optional view-only account; both fields must be configured together.
PLANNER_VIEWER_USERNAME=
PLANNER_VIEWER_PASSWORD=

# Bind remains 127.0.0.1; expose through your own HTTPS reverse proxy.
PORT=5180
